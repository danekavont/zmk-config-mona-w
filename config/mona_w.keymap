#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        qwerty {
            bindings = <
&gresc     &kp N1    &kp N2    &kp N3  &kp N4  &kp N5  &kp NUMBER_6  &kp N7  &kp N8     &kp N9     &kp N0    &kp MINUS  &kp EQUAL  &kp BSLH   &kp DEL
&kp TAB    &kp Q     &kp W     &kp E   &kp R   &kp T   &kp Y         &kp U   &kp I      &kp O      &kp P     &kp LBKT   &kp RBKT              &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D   &kp F   &kp G   &kp H         &kp J   &kp K      &kp L      &kp SEMI  &kp SQT               &kp RET
&kp LSHFT            &kp Z     &kp X   &kp C   &kp V   &kp B         &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH              &kp RSHFT  &mo 1
&kp LCTRL  &kp LGUI  &kp LALT                                                &kp SPACE             &mo 1     &kp RALT              &kp RGUI   &kp RCTRL
            >;
        };

        layer_3 {
            bindings = <
&trans    &kp F1        &kp F2      &kp F3         &kp F4        &kp F5         &kp F6        &kp F7         &kp F8        &kp F9        &kp F10       &kp F11       &kp F12        &trans     &kp PRINTSCREEN
&trans    &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)  &kp LS(PLUS)  &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(UNDER)             &kp DEL
&trans    &kp N1        &kp N2      &kp N3         &kp N4        &kp N5         &kp EQUAL     &kp N6         &kp N7        &kp N8        &kp N9        &kp N0                       &kp MINUS
&kp HOME                &trans      &kp LEFT       &kp DOWN      &kp UP         &kp RIGHT     &trans         &trans        &trans        &trans        &trans                       &kp UP     &mo 2
&trans    &trans        &trans                                                                               &trans                      &mo 2         &kp LEFT                     &kp DOWN   &kp RIGHT
            >;
        };

        fn_layer {
            bindings = <
&kp GRAVE   &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6     &kp F7    &kp F8           &kp F9     &kp F10    &kp F11    &kp F12  &kp DELETE  &kp DELETE
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK  &trans     &trans     &kp UP     &trans               &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans     &trans    &kp HOME         &kp PG_UP  &kp LEFT   &kp RIGHT           &trans
&trans                    &trans        &trans        &trans        &trans        &trans     &trans    &trans           &kp END    &kp PG_DN  &kp DOWN            &trans      &trans
&trans      &trans        &trans                                                                       &trans                      &trans     &trans              &trans      &trans
            >;
        };
    };
};
